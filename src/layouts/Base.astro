---
import { withBase } from '../lib';
interface Props { title?: string; description?: string }
const { title, description = '지한이의 하루하루를 담은 부모의 일기' } = Astro.props;
const pageTitle = title ? `${title} · 지한군일기` : '지한군일기';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf7f1" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={withBase('/')} class="brand">지한군일기</a>
      <p class="tagline">지한이의 하루하루</p>
      <nav class="nav">
        <a href={withBase('/')}>일기</a>
        <a href={withBase('/map/')}>지도</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">© 지한군일기</footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #fbf7f1; --card: #ffffff; --text: #3b322c; --muted: #8a7d72;
    --accent: #d98e6a; --line: #eee4d8; --radius: 16px;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Pretendard', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
    line-height: 1.75; word-break: keep-all; overflow-wrap: anywhere;
  }
  main { max-width: 680px; margin: 0 auto; padding: 0 18px 48px; }
  a { color: inherit; }
  img { max-width: 100%; display: block; }
  .site-header { max-width: 680px; margin: 0 auto; padding: 36px 18px 20px; text-align: center; }
  .brand { font-size: 1.7rem; font-weight: 700; text-decoration: none; letter-spacing: -0.02em; }
  .brand::before { content: '🌱 '; }
  .tagline { margin: 4px 0 0; color: var(--muted); font-size: 0.92rem; }
  .nav { display: flex; justify-content: center; gap: 8px; margin-top: 14px; }
  .nav a { text-decoration: none; font-size: 0.9rem; padding: 6px 14px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); }
  .nav a:hover { border-color: var(--accent); color: var(--accent); }
  .site-footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px 0 40px; }
</style>
